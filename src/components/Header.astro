---
const links = [
  { name: "Olho Seco", href: "/olho-seco" },
  { name: "Exames", href: "/exames" },
  { name: "Tratamentos", href: "/tratamentos" },
  { name: "IRPL E-Eye", href: "/tratamentos/luz-pulsada-irpl" },
  { name: "Quiz Olho Seco", href: "/quiz" },
  { name: "Calculadora", href: "/calculadora-olho-seco" },
  { name: "Vídeos", href: "/videos" },
  { name: "Blog", href: "/blog" },
];

const currentPath = Astro.url.pathname;
const isTestPage = currentPath === '/testerapido';
---

<header class="fixed w-full z-50 transition-all duration-300 border-b border-slate-200 shadow-sm bg-white/90 backdrop-blur-md">
  <div class="container py-3 flex justify-between items-center">
    <a href="/" class="block transition-transform hover:scale-[1.02]">
      <picture>
        <source
          type="image/avif"
          srcset="/optimized/logo_prata-77.avif 77w, /optimized/logo_prata-224.avif 224w"
          sizes="(min-width: 768px) 64px, 56px"
        />
        <source
          type="image/webp"
          srcset="/optimized/logo_prata-77.webp 77w, /optimized/logo_prata-224.webp 224w"
          sizes="(min-width: 768px) 64px, 56px"
        />
        <img
          src="/optimized/logo_prata-224.webp"
          alt="Saraiva Vision - Olho Seco Caratinga"
          width="224"
          height="224"
          loading="eager"
          decoding="async"
          class="h-14 md:h-16 w-auto object-contain"
        />
      </picture>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {links.map((link) => (
        <a 
          href={link.href} 
          class="text-slate-600 hover:text-cyan-600 font-medium text-sm transition-all relative group"
        >
          {link.name}
          <span class="absolute inset-x-0 -bottom-1 h-0.5 bg-cyan-400 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></span>
        </a>
      ))}
      {!isTestPage && (
        <a href="/testerapido" class="hidden lg:flex items-center gap-2 px-4 py-2 bg-cyan-50 text-cyan-600 rounded-lg hover:bg-cyan-100 font-bold transition-colors text-sm border border-cyan-200 shadow-sm animate-pulse-slow">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Teste 10s
        </a>
      )}
      {isTestPage && (
        <a href="https://saraivavision.com.br" target="_blank" class="hidden lg:flex items-center gap-2 px-4 py-2 bg-[#003D7A] text-white rounded-lg hover:bg-blue-900 font-bold transition-colors text-sm shadow-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Site Principal
        </a>
      )}
      <a href="/olho-seco" class="btn-premium btn-premium-primary !py-2 md:!py-2.5 !px-4 md:!px-6 text-xs md:text-sm shadow-md flex items-center gap-2 whitespace-nowrap">
        <span>Saiba mais</span>
      </a>
    </nav>

    <!-- Mobile Menu Button (Hamburger) -->
    <button id="mobile-menu-btn" class="md:hidden text-gray-700 focus:outline-none" aria-controls="mobile-menu" aria-expanded="false" aria-label="Abrir menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-white border-b border-gray-100 shadow-xl overflow-hidden" role="dialog" aria-modal="true">
    <div class="flex flex-col p-6 space-y-3">
      {links.map((link) => (
        <a 
          href={link.href} 
          data-mobile-link
          class="text-[var(--text-main)] font-semibold p-4 block rounded-xl hover:bg-[var(--accent)] transition-all"
        >
          {link.name}
        </a>
      ))}
      {!isTestPage && (
        <a href="/testerapido" data-mobile-link class="rounded-xl border border-cyan-200 bg-cyan-50 p-4 text-center font-bold text-cyan-600 shadow-sm transition-all hover:bg-cyan-100 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Fazer Teste dos 10 Segundos
        </a>
      )}
      {isTestPage && (
        <a href="https://saraivavision.com.br" target="_blank" data-mobile-link class="rounded-xl border border-blue-200 bg-[#003D7A] p-4 text-center font-bold text-white shadow-sm transition-all hover:bg-blue-900 flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Ir para Site Principal
        </a>
      )}
      <a href="/olho-seco" data-mobile-link class="btn-premium btn-premium-primary w-full mt-4 flex justify-center items-center gap-2">
        Saiba mais sobre olho seco
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');

  const closeMenu = () => {
    if (!menu?.classList.contains('hidden')) {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.setAttribute('aria-label', 'Abrir menu');
    }
  };

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const isExpanded = btn?.getAttribute('aria-expanded') === 'true';
    btn?.setAttribute('aria-expanded', String(!isExpanded));
    btn?.setAttribute('aria-label', isExpanded ? 'Abrir menu' : 'Fechar menu');
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeMenu();
    }
  });
</script>
