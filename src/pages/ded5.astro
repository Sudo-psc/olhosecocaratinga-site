---
import Layout from '../layouts/Layout.astro';

// DEQ-5 (Dry Eye Questionnaire 5) page
---

<Layout
  title="Questionário de Olho Seco DEQ-5 | Avaliação Online"
  description="Realize o questionário DEQ-5 validado cientificamente para avaliar o nível de desconforto e ressecamento dos seus olhos em menos de 1 minuto."
>
  <div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8 bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-gray-100 relative overflow-hidden">
      
      <!-- Progress Bar -->
      <div id="progress-container" class="absolute top-0 left-0 w-full h-2 bg-gray-100 hidden">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-cyan-500 to-blue-600 transition-all duration-500 ease-out" style="width: 0%"></div>
      </div>

      <!-- Intro Step -->
      <div id="step-intro" class="text-center space-y-6">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-cyan-50 rounded-full mb-4">
          <span class="text-4xl">📝</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-[#003D7A] leading-tight">
          Teste de Olho Seco <span class="text-cyan-600">DEQ-5</span>
        </h1>
        <p class="text-gray-600 text-lg max-w-lg mx-auto">
          O DEQ-5 é um questionário validado cientificamente para medir a gravidade dos sintomas de olho seco. Responda 5 perguntas rápidas e descubra seu índice.
        </p>
        <div class="pt-4">
          <button id="btn-start" class="btn-premium btn-premium-primary text-lg w-full sm:w-auto">
            Começar Avaliação
          </button>
        </div>
        <p class="text-xs text-gray-400">
          *Este questionário é uma ferramenta de triagem e não substitui o diagnóstico médico especializado.
        </p>
      </div>

      <!-- Quiz Step (Dynamic) -->
      <div id="step-quiz" class="hidden space-y-8">
        <div id="question-container" class="space-y-6">
          <span id="question-number" class="text-cyan-600 font-bold uppercase tracking-widest text-sm block">Pergunta 1 de 5</span>
          <h2 id="question-text" class="text-2xl font-bold text-[#003D7A]">Texto da Pergunta</h2>
          <div id="options-container" class="grid gap-4">
            <!-- Options will be injected here -->
          </div>
        </div>
      </div>

      <!-- Lead Capture Step -->
      <div id="step-lead" class="hidden space-y-8">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-[#003D7A] mb-4">Quase lá!</h2>
          <p class="text-gray-600">
            Preencha seus dados para calcular seu score DEQ-5 e receber a recomendação personalizada:
          </p>
        </div>
        
        <form id="lead-form" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nome Completo</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border-gray-200 focus:ring-cyan-500 focus:border-cyan-500 border" placeholder="Seu nome">
          </div>
          <div>
            <label for="whatsapp" class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
            <input type="tel" id="whatsapp" name="whatsapp" required class="w-full px-4 py-3 rounded-xl border-gray-200 focus:ring-cyan-500 focus:border-cyan-500 border" placeholder="(00) 00000-0000">
          </div>
          <button type="submit" class="btn-premium btn-premium-primary w-full text-lg mt-4">
            Ver Resultado do Score
          </button>
        </form>
      </div>

      <!-- Result Step -->
      <div id="step-result" class="hidden space-y-8 text-center">
        <div id="result-icon-container" class="inline-flex items-center justify-center w-20 h-20 bg-blue-50 rounded-full mb-4 transition-colors duration-500">
          <span id="result-emoji" class="text-4xl">📊</span>
        </div>
        <div class="space-y-2">
          <h2 id="result-title" class="text-3xl font-bold text-[#003D7A]">Seu Score DEQ-5: 12</h2>
          <p id="result-classification" class="text-xl font-semibold text-cyan-600 uppercase tracking-wide">Olho Seco Grave</p>
        </div>
        
        <div id="result-description" class="text-gray-600 text-lg space-y-4 text-left bg-gray-50 p-6 rounded-2xl border border-gray-100">
          <!-- Description will be injected here -->
        </div>
        
        <div class="bg-cyan-50 p-6 rounded-2xl border border-cyan-100 text-center">
          <h3 class="text-xl font-bold text-cyan-800 mb-2">Conteúdo educativo</h3>
          <p class="text-cyan-700 mb-6">
            A unidade de Caratinga está encerrada. Este questionário é informativo e não inclui agendamento.
          </p>
          <a id="whatsapp-link" href="/olho-seco" class="btn-premium btn-premium-primary w-full sm:w-auto flex items-center justify-center gap-2">
            Saiba mais sobre olho seco
          </a>
        </div>
        
        <button id="btn-restart" class="text-sm text-gray-400 underline hover:text-cyan-600">
          Refazer o questionário
        </button>
      </div>

    </div>
  </div>

  <script is:inline>
    const questions = [
      {
        question: "Com que frequência seus olhos sentem desconforto?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Raramente", score: 1 },
          { text: "Às vezes", score: 2 },
          { text: "Frequentemente", score: 3 },
          { text: "Constantemente", score: 4 }
        ]
      },
      {
        question: "Quão intenso é o desconforto ocular no final do dia?",
        options: [
          { text: "Não sinto desconforto", score: 0 },
          { text: "Muito leve", score: 1 },
          { text: "Leve", score: 2 },
          { text: "Moderado", score: 3 },
          { text: "Intenso", score: 4 },
          { text: "Muito intenso", score: 5 }
        ]
      },
      {
        question: "Com que frequência seus olhos parecem secos?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Raramente", score: 1 },
          { text: "Às vezes", score: 2 },
          { text: "Frequentemente", score: 3 },
          { text: "Constantemente", score: 4 }
        ]
      },
      {
        question: "Quão intenso é o ressecamento ocular no final do dia?",
        options: [
          { text: "Não sinto ressecamento", score: 0 },
          { text: "Muito leve", score: 1 },
          { text: "Leve", score: 2 },
          { text: "Moderado", score: 3 },
          { text: "Intenso", score: 4 },
          { text: "Muito intenso", score: 5 }
        ]
      },
      {
        question: "Com que frequência sua visão fica embaçada?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Raramente", score: 1 },
          { text: "Às vezes", score: 2 },
          { text: "Frequentemente", score: 3 },
          { text: "Constantemente", score: 4 }
        ]
      }
    ];

    let currentStep = 'intro';
    let currentQuestionIndex = 0;
    let totalScore = 0;
    let userAnswers = [];

    const steps = {
      intro: document.getElementById('step-intro'),
      quiz: document.getElementById('step-quiz'),
      lead: document.getElementById('step-lead'),
      result: document.getElementById('step-result')
    };

    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');

    function showStep(stepName) {
      Object.keys(steps).forEach(key => {
        steps[key].classList.add('hidden');
      });
      steps[stepName].classList.remove('hidden');
      currentStep = stepName;

      if (stepName === 'quiz' || stepName === 'lead') {
        progressContainer.classList.remove('hidden');
      } else {
        progressContainer.classList.add('hidden');
      }
    }

    function updateProgress() {
      const progress = ((currentQuestionIndex) / questions.length) * 100;
      progressBar.style.width = `${progress}%`;
    }

    function renderQuestion() {
      const q = questions[currentQuestionIndex];
      document.getElementById('question-number').textContent = `Pergunta ${currentQuestionIndex + 1} de ${questions.length}`;
      document.getElementById('question-text').textContent = q.question;
      
      const optionsContainer = document.getElementById('options-container');
      optionsContainer.innerHTML = '';
      
      q.options.forEach((opt, idx) => {
        const button = document.createElement('button');
        button.className = "text-left px-6 py-4 rounded-xl border border-gray-200 hover:border-cyan-500 hover:bg-cyan-50 transition-all font-medium text-gray-700";
        button.textContent = opt.text;
        button.onclick = () => handleAnswer(opt.score);
        optionsContainer.appendChild(button);
      });
      
      updateProgress();
    }

    function handleAnswer(score) {
      totalScore += score;
      userAnswers.push(score);
      
      if (currentQuestionIndex < questions.length - 1) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        progressBar.style.width = '100%';
        setTimeout(() => {
          showStep('lead');
        }, 300);
      }
    }

    function calculateResult() {
      let classification = "";
      let description = "";
      let emoji = "📊";
      let colorClass = "bg-blue-50";
      
      if (totalScore < 6) {
        classification = "Normal / Sintomas Leves";
        emoji = "✨";
        colorClass = "bg-green-50";
        description = "<p>Seu score DEQ-5 indica que seus sintomas estão dentro da normalidade ou são muito leves.</p><p><strong>Dica:</strong> Continue cuidando da sua lubrificação ocular, especialmente se você passa muito tempo em frente a telas.</p>";
      } else if (totalScore < 12) {
        classification = "Olho Seco Sugestivo (Leve a Moderado)";
        emoji = "⚠️";
        colorClass = "bg-yellow-50";
        description = "<p>Seu score indica a presença de sintomas sugestivos de Olho Seco de intensidade moderada.</p><p><strong>Recomendação:</strong> Você pode estar sofrendo de instabilidade lacrimal. Uma avaliação clínica é recomendada para identificar a causa e evitar a progressão.</p>";
      } else {
        classification = "Olho Seco Grave";
        emoji = "💧";
        colorClass = "bg-red-50";
        description = "<p>Seu score atingiu um nível crítico, o que é fortemente sugestivo de <strong>Olho Seco Grave</strong> ou disfunção severa do filme lacrimal.</p><p><strong>Urgência:</strong> É fundamental realizar uma Meibografia e uma avaliação especializada para iniciar o tratamento adequado (como a Luz Pulsada IRPL) e restaurar seu conforto ocular.</p>";
      }
      
      document.getElementById('result-title').textContent = `Seu Score DEQ-5: ${totalScore}`;
      document.getElementById('result-classification').textContent = classification;
      document.getElementById('result-emoji').textContent = emoji;
      document.getElementById('result-description').innerHTML = description;
      document.getElementById('result-icon-container').className = `inline-flex items-center justify-center w-20 h-20 rounded-full mb-4 transition-colors duration-500 ${colorClass}`;
      
      document.getElementById('whatsapp-link').href = '/olho-seco';
    }

    // Event Listeners
    document.getElementById('btn-start').onclick = () => {
      showStep('quiz');
      renderQuestion();
    };

    document.getElementById('lead-form').onsubmit = (e) => {
      e.preventDefault();
      
      // Collect lead data
      const name = document.getElementById('name').value;
      const whatsapp = document.getElementById('whatsapp').value;
      
      // Logic for sending to API if needed
      console.log('Lead:', { name, whatsapp, score: totalScore });
      
      calculateResult();
      showStep('result');
    };

    document.getElementById('btn-restart').onclick = () => {
      currentQuestionIndex = 0;
      totalScore = 0;
      userAnswers = [];
      showStep('intro');
    };
  </script>
</Layout>
