  </main>

  <script is:inline>
    const formatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    const items = Array.from(document.querySelectorAll('[data-item]'));

    const recalc = () => {
      let totalMonthly = 0;
      let totalAnnual = 0;

      items.forEach((item) => {
        const isChecked = item.querySelector('[data-check]')?.checked;
        const priceInput = item.querySelector('[data-price]');
        const type = item.getAttribute('data-type');
        const price = parseFloat(priceInput?.value || '0');

        let monthly = 0;
        let annual = 0;

        if (isChecked && price > 0) {
          if (type === 'one-time') {
            monthly = price / 12;
            annual = price;
            const monthlyEl = item.querySelector('[data-monthly]');
            if (monthlyEl) monthlyEl.textContent = formatter.format(monthly);
          } else {
            monthly = price;
            annual = price * 12;
          }
        } else if (type === 'one-time') {
          const monthlyEl = item.querySelector('[data-monthly]');
          if (monthlyEl) monthlyEl.textContent = formatter.format(0);
        }

        const annualEl = item.querySelector('[data-annual]');
        if (annualEl) annualEl.textContent = formatter.format(annual);

        totalMonthly += monthly;
        totalAnnual += annual;
      });

      document.getElementById('total-monthly').textContent = formatter.format(totalMonthly);
      document.getElementById('total-annual').textContent = formatter.format(totalAnnual);
    };

    items.forEach((item) => {
      item.addEventListener('input', recalc);
      item.addEventListener('change', recalc);
    });

    recalc();
  </script>
</Layout>
